VITE_API_URL=http://localhost:3001/api
# Set per deployment: farmer, consumer, delivery, or admin. Leave empty for the public landing app.
VITE_APP_ROLE=
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Backend
GREENLINK_ALLOWED_ORIGINS=http://localhost:5173
GREENLINK_AUTH_SECRET=replace-with-a-long-random-secret
ADMIN_PASSWORD=replace-with-a-strong-password
# Set this in production to use managed PostgreSQL. Leave empty for local SQLite development.
GREENLINK_DATABASE_URL=
